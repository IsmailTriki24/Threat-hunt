# Copy to .env (or run ./scripts/init-env.sh to generate random secrets).
# Values prefixed with "dev-only-" are rejected when APP_ENV != development.

APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=hunt
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=hunt

# --- Redis ---
REDIS_PASSWORD=dev-only-redis-password

# --- OpenSearch (security plugin disabled in the dev compose file; enable TLS+auth in production) ---
OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m"

# --- MinIO (object storage for reports/evidence, used from milestone 3) ---
MINIO_ROOT_USER=huntminio
MINIO_ROOT_PASSWORD=dev-only-minio-password

# --- Application secrets ---
# >= 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef

# Fernet key encrypting data-source secrets at rest. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (empty => derived from JWT_SECRET; required in production)
DATA_ENCRYPTION_KEY=

# --- Demo data (seeded by the `init` service when SEED_DEMO_DATA=true) ---
SEED_DEMO_DATA=true
# Password for all seeded demo users. Leave empty to generate a random one (printed in init logs).
SEED_PASSWORD=dev-only-Demo-Passw0rd!

# --- Published ports (bound to 127.0.0.1 only) ---
FRONTEND_PORT=3100
BACKEND_PORT=8100
POSTGRES_PORT=5432
REDIS_PORT=6379
OPENSEARCH_PORT=9210
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011

# AI hunting (optional). Leave AI_PROVIDER=none to disable; the rest of the platform is unaffected.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Web search for the AI agent (optional, Tavily). Queries leave the platform; internal hostnames/users/IPs are blocked from them.
TAVILY_API_KEY=

# Pull connectors reaching specific private hosts (e.g. an on-prem SIEM). Narrow CIDRs only; public hosts need no entry.
OUTBOUND_ALLOWED_NETWORKS=
OUTBOUND_ALLOWED_PORTS=80,443,8080,8443,9200

# Threat map (optional). GeoIP is read locally from MaxMind-format files in ./data/geoip - run scripts/fetch-geoip.sh to download
# DB-IP Lite (CC BY 4.0, no key) or place GeoLite2-City.mmdb / GeoLite2-ASN.mmdb there and point the paths at them.
GEOIP_PROVIDER=mmdb
GEOIP_DB_PATH=/srv/geoip/dbip-city-lite.mmdb
GEOIP_ASN_DB_PATH=/srv/geoip/dbip-asn-lite.mmdb
# Where your network sits, so inbound/outbound arcs have a real far end. Leave blank to draw arcs only between two public addresses.
THREATMAP_HOME_LAT=
THREATMAP_HOME_LON=
THREATMAP_HOME_LABEL=Our network
# Your own public address space (comma-separated CIDRs): treated as 'ours', never mapped as remote endpoints.
THREATMAP_OWN_NETWORKS=

# Browser origins allowed to call the API (comma-separated). Set to your public URL behind a reverse proxy,
# e.g. https://threat-hunt.financialcert.tn. Empty => http://localhost:$FRONTEND_PORT.
CORS_ORIGINS=

# Single sign-on through an OpenID Connect provider (e.g. Authentik). Leave blank to keep password sign-in only.
# The provider proves identity (matched by e-mail); the platform grants roles. Without auto-provisioning, users must
# already exist on the platform.
# Register OIDC_REDIRECT_URI with the provider, and <app>/api/v1/auth/oidc/backchannel-logout as its back-channel logout URI.
# If the provider's hostname does not resolve inside the containers, add it under extra_hosts in docker-compose.override.yml.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_PROVIDER_NAME=Authentik
# Create users on first SSO sign-in; one with no membership joins OIDC_DEFAULT_TENANT (slug) as OIDC_DEFAULT_ROLE
# (TENANT_ADMIN, SOC_ANALYST, THREAT_HUNTER, INCIDENT_RESPONDER or VIEWER). Admins adjust roles afterwards.
OIDC_AUTO_PROVISION=false
OIDC_DEFAULT_TENANT=
OIDC_DEFAULT_ROLE=VIEWER
# Comma-separated e-mails that become platform super admins when they sign in through SSO.
OIDC_SUPER_ADMINS=

# Web UI bind address: 127.0.0.1 (default, this machine only) or 0.0.0.0 to reach it from other machines on your network.
FRONTEND_BIND=127.0.0.1
